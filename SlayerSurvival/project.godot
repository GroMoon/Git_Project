[internationalization]

locale/translations=PackedStringArray("res://static/translation/slayer_language_test_utf8.en.translation", "res://static/translation/slayer_language_test_utf8.ko.translation")

[layer_names]

2d_physics/layer_1="map"
2d_physics/layer_2="player"
2d_physics/layer_3="enemy"
2d_physics/layer_4="attack"
2d_physics/layer_6="collision"
